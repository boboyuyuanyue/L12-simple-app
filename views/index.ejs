<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>My Budget Tracker</title>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container mt-5 text-center">
        <h1>Welcome to My Budget Tracker!</h1>
        <p>Track your items and spending</p>

        <div class="card mt-4 mx-auto" style="width: 20rem;">
            <div class="card-header">
                <h4>Total Value</h4>
            </div>
            <div class="card-body">
                <% let total = 0; %>
                <% items.forEach(function(item) { %>
                    <% total += item.value; %>
                <% }); %>
                <h2 class="display-4">$<%= total %></h2>
            </div>
        </div>

        <div class="mt-4">
            <a href="/add" class="btn btn-primary me-2">Add Item</a>
            <a href="/list" class="btn btn-secondary">View List</a>
        </div>
    </div>
</body>
</html>
