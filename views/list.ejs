<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>My Simple Application</title>
</head>
<body>
    <%- include('partials/navbar') %>

    <div class="container mt-5">
        <h1>Edit Item</h1>
        <p>Update the item details</p>

        <form action="/edit/<%= item.id %>" method="POST" class="mt-4">
            <div class="mb-3">
                <label for="name" class="form-label">Item Name</label>
                <input type="text" class="form-control" id="name" name="name" value="<%= item.name %>" required>
            </div>
            <div class="mb-3">
                <label for="value" class="form-label">Item Value</label>
                <input type="number" class="form-control" id="value" name="value" value="<%= item.value %>" required>
            </div>
            <button type="submit" class="btn btn-primary">Update Item</button>
            <a href="/list" class="btn btn-secondary ms-2">Cancel</a>
        </form>
    </div>
</body>
</html>
